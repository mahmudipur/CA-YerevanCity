# ── Yerevan City API (legacy/CLI-only — see scripts/migrate_legacy_env.py) ───
YC_PHONE_LOCAL=
YC_PHONE_E164=
YC_DEVICE_ID=
YC_JWT=

# ── Participants (legacy/CLI-only; per-user default lives in the DB now) ────
DEFAULT_PARTICIPANTS=Me

# ── Google Sheets (legacy/CLI-only) ──────────────────────────────────────────
GOOGLE_SHEET_ID=

# ── Web app: Telegram Login (OPTIONAL) ────────────────────────────────────────
# Leave all three blank to run username/password-only — the frontend hides
# the Telegram widget entirely when TELEGRAM_BOT_USERNAME is empty. Only
# fill these in once you have a fixed public domain: Telegram's widget is
# bound to one exact hostname via BotFather's /setdomain and will NOT work
# behind a free ngrok tunnel's rotating URL.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_LOGIN_DOMAIN=

# ── Web app: secrets ──────────────────────────────────────────────────────────
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_MASTER_KEY=
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SESSION_SECRET=
# Set to false ONLY for local http:// dev without ngrok/TLS.
APP_SESSION_COOKIE_SECURE=true
